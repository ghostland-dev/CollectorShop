# EditorConfig - Configuration de formatage pour tous les éditeurs
# https://editorconfig.org

root = true

# Paramètres par défaut pour tous les fichiers
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Fichiers TypeScript/JavaScript
[*.{ts,tsx,js,jsx}]
indent_size = 2

# Fichiers JSON
[*.json]
indent_size = 2

# Fichiers YAML
[*.{yml,yaml}]
indent_size = 2

# Fichiers Markdown (conserver les espaces en fin de ligne)
[*.md]
trim_trailing_whitespace = false

# Makefile (utilise des tabs)
[Makefile]
indent_style = tab

# Fichiers Python
[*.py]
indent_size = 4

# Fichiers shell
[*.sh]
indent_size = 2
